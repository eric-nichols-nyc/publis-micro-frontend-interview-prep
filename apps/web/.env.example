# Copy to `.env.local` and fill in values.
# See https://next-forge.com/docs/setup/env

# --- Required (local URLs) ---

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3001"

# --- Optional: Authentication (Clerk; used by proxy.ts) ---

CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# --- Optional: CMS (BaseHub) ---

BASEHUB_TOKEN=""

# --- Optional: Email (Resend, contact form) ---

RESEND_TOKEN=""
RESEND_FROM=""

# --- Optional: Analytics ---

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Optional: Observability (Sentry, Better Stack) ---

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""

# --- Optional: Feature flags toolbar (Vercel Toolbar) ---

FLAGS_SECRET=""

# --- Optional: Security (Arcjet bot protection) ---

ARCJET_KEY=""

# --- Optional: Rate limiting (Upstash Redis) ---

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
