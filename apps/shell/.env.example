# API (shell → apps/api)
VITE_API_BASE_URL=http://localhost:3001

# Module Federation remote entry URLs (baked into shell at build time)
# Dev defaults in vite.config.ts: :5174 / :5175 — override for staging/prod or local preview.
VITE_MFE_PRODUCTS_URL=http://localhost:5174/remoteEntry.js
VITE_MFE_CART_URL=http://localhost:5175/remoteEntry.js

# Optional when checkout remote exists (spec 06):
# VITE_MFE_CHECKOUT_URL=http://localhost:5176/remoteEntry.js

# Neon Auth (production-shaped sign-in; omit for API DEV_AUTH_* demo)
# VITE_NEON_AUTH_URL=
