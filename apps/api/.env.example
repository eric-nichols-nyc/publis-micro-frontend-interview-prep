PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# DATABASE_URL — load from packages/database/.env or set here

# --- Shell auth (email/password, cookie session) ---
# Optional in development (API uses a dev default). Required in production.
# SESSION_SECRET=<32+ random characters>

# --- Optional: Neon Auth (legacy; shell uses API auth by default) ---
# NEON_AUTH_BASE_URL=https://<project>.neonauth.<region>.aws.neon.tech/<db>/auth
# NEON_AUTH_COOKIE_SECRET=<32+ characters from Neon console>

# --- Optional: federation demo only (no real sign-up / sign-out) ---
# DEV_AUTH_USER_ID=dev-user-1
# DEV_AUTH_EMAIL=dev@example.com
