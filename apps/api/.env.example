# Copy to `.env.local` and fill in values.
# See https://next-forge.com/docs/setup/env

# --- Required (local URLs) ---

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
VERCEL_PROJECT_PRODUCTION_URL="http://localhost:3002"

# --- Required (database, for webhook handlers that sync data) ---

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Optional: Authentication webhooks (Clerk) ---

CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# --- Optional: Payments webhooks (Stripe) ---

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional: Email (Resend) ---

RESEND_TOKEN=""
RESEND_FROM=""

# --- Optional: Analytics (webhook event tracking) ---

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Optional: Observability (Sentry, Better Stack) ---

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
BETTERSTACK_API_KEY=""
BETTERSTACK_URL=""
