PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Load DATABASE_URL from packages/database/.env or set here
# DATABASE_URL=

# Dev auth (no Neon Auth project required)
DEV_AUTH_USER_ID=dev-user-1
DEV_AUTH_EMAIL=dev@example.com

# Or production Neon Auth:
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
